# ─────────────────────────────────────────────────────────────────────────────
# House of Garden — site configuration
#
# Copy to `.env.local` for local work. On Cloudflare Pages add the same names
# under Settings → Variables and Secrets (see README for Production vs Preview).
#
# All NEXT_PUBLIC_* values are compiled into the public site. Never put a
# password, SMTP login or secret API key in here.
# ─────────────────────────────────────────────────────────────────────────────

# Verified production domain, https, no trailing slash. e.g. https://www.houseofgarden.in
# Setting this turns the site "live": indexable, sitemap.xml, canonical URLs,
# structured data. Leave it EMPTY for previews/staging: the site is then
# noindex, robots.txt blocks crawlers and demo content may be shown.
NEXT_PUBLIC_SITE_URL=

# Business WhatsApp number, international format, digits only (country code, no + or spaces).
# e.g. 919876543210  — REQUIRED before going live. The build fails if it is missing
# while NEXT_PUBLIC_SITE_URL is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: number shown/used for phone calls (+91 98765 43210). Hidden if empty.
NEXT_PUBLIC_PHONE=

# Optional: public business email. Shown as a mailto link. Hidden if empty.
NEXT_PUBLIC_EMAIL=

# Optional: verified office address as a single line. Hidden if empty.
# (A clearly marked DEMO address appears on preview builds only.)
NEXT_PUBLIC_ADDRESS=

# Optional: social profiles and the verified Google Business reviews link.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Optional: form service endpoint that emails each enquiry to you in the background
# (e.g. https://formspree.io/f/xxxxxxxx). A public endpoint URL only — no secrets.
# If empty, the form only opens WhatsApp. See README → "Email delivery".
NEXT_PUBLIC_FORM_ENDPOINT=

# Images in /public/images are illustrative samples. Set to "false" once you have
# replaced them with real project photographs (hides the "Sample illustration" labels).
NEXT_PUBLIC_SAMPLE_IMAGES=true

# Preview only: set "true" to force the DEMO testimonials / DEMO address to show on
# a live build too. Leave empty in production.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=

# Emergency escape hatch for scripts/check-config.mjs (lets a live build pass with
# placeholders). Do not use for the real launch.
NEXT_PUBLIC_ALLOW_PLACEHOLDERS=
